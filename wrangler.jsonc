// Cloudflare Worker + static assets. `wrangler deploy` runs the build itself,
// so no build command is needed in the Cloudflare dashboard.
// The Worker (worker/index.ts) only runs for /api/*; everything else is served straight from dist/.
// Secrets (TELEGRAM_BOT_TOKEN, SUPABASE_SECRET_KEY, FREEMIUS_SECRET_KEY, FREEMIUS_API_TOKEN) are set in the
// Cloudflare dashboard, never here. Freemius ids and the public key are public, so they live below.
{
  "name": "app",
  "main": "worker/index.ts",
  "compatibility_date": "2026-11-01",
  "build": { "command": "npm run build" },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  // Every 5 minutes: Telegram reading summaries for finished visits (also keeps Supabase free tier from pausing).
  "triggers": { "crons": ["*/5 * * * *"] },
  // Freemius: FREEMIUS_SANDBOX "true" opens the checkout in sandbox (test cards, no real money); set "false" to go live.
  "vars": {
    "FREEMIUS_PRODUCT_ID": "45012",
    "FREEMIUS_PLAN_ID": "79373",
    "FREEMIUS_PUBLIC_KEY": "pk_67358a8fd0d9b7905bb2786b85770",
    "FREEMIUS_SANDBOX": "true",
    // While in sandbox, only these accounts may open the (test) checkout.
    "FREEMIUS_TEST_EMAILS": "sgoo0931@gmail.com"
  },
  "keep_vars": true
}
